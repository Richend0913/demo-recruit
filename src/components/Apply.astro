---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
---

<section class="section apply-sec" id="apply" style="scroll-margin-top:60px">
  <div class="container apply-in">
    <SectionHead
      label="応募・お問い合わせ"
      title="まずは話を聞くだけ、でも大歓迎です。"
      lead="右下のAI応募受付で、いつでも質問・応募できます。合否はAIでは決まりません（担当者が面談します）。お電話でもどうぞ。"
    />

    <div class="apply-box">
      <form id="applyForm" novalidate>
        <div class="fld">
          <label for="f-name">お名前 <span class="req">必須</span></label>
          <input id="f-name" name="name" required placeholder="山田 太郎" autocomplete="name" />
        </div>
        <div class="fld">
          <label for="f-age">年代 <span class="req">必須</span></label>
          <select id="f-age" name="age" required>
            <option value="">選択してください</option>
            <option value="20代">20代</option>
            <option value="30代">30代</option>
            <option value="40代">40代</option>
            <option value="50代">50代</option>
            <option value="60代以上">60代以上</option>
          </select>
        </div>
        <div class="fld">
          <label for="f-area">居住エリア <span class="req">必須</span></label>
          <input id="f-area" name="area" required placeholder="神奈川県相模原市" />
        </div>
        <div class="fld">
          <label for="f-tel">電話番号 <span class="req">必須</span></label>
          <input
            id="f-tel"
            name="tel"
            type="tel"
            required
            placeholder="090-0000-0000"
            autocomplete="tel"
          />
        </div>
        <div class="fld">
          <label for="f-email">メールアドレス <span class="req">必須</span></label>
          <input
            id="f-email"
            name="email"
            type="email"
            required
            placeholder="example@mail.com"
            autocomplete="email"
          />
          <p class="fineprint">応募確認の自動返信をお送りします</p>
        </div>
        <div class="fld">
          <label for="f-exp">経験 <span class="req">必須</span></label>
          <input id="f-exp" name="exp" required placeholder="未経験／宅配経験2年 など" />
        </div>
        <div class="fld">
          <label for="f-pref">希望稼働 <span class="req">必須</span></label>
          <input id="f-pref" name="pref" required placeholder="週4日／平日のみ など" />
        </div>
        <div class="fld">
          <label for="f-msg">ひとこと（わかる範囲でOK）</label>
          <textarea
            id="f-msg"
            rows="3"
            placeholder="未経験ですが興味あります／希望エリアなど"></textarea>
        </div>
        <div class="fld hp-field" aria-hidden="true">
          <label
            >この欄は入力しないでください<input
              type="text"
              id="f-honey"
              name="_honey"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </div>
        <div class="fld consent">
          <label for="f-consent">
            <input id="f-consent" name="consent" type="checkbox" required />
            個人情報の取扱いに同意します<span class="req">必須</span>
          </label>
        </div>
        <button id="f-submit" class="btn btn--primary btn--arrow submit" type="submit"
          >この内容で応募する（デモ）</button
        >
        <p class="msg" id="f-status" role="status" aria-live="polite"></p>
      </form>
      <p id="done" class="done">
        応募を受け付けました（デモ）。実際のLPでは担当者に通知が届き、24時間以内にご連絡します。
      </p>
    </div>

    <aside class="honest">
      <p>
        <strong>正直にお伝えします。</strong>
        <Phrases
          text="これは業務委託であり、雇用ではありません（社会保険・雇用保険・有給はありません）。収入は出来高で、金額の保証はありません。車両リース・ガソリン・保険などの経費がかかります。上記はすべて事実です。合わないと感じたら、無理にお勧めしません。"
        />
      </p>
    </aside>
  </div>
</section>

<style>
  /* 応募はオレンジのバンドにし、白いフォームカードを浮かべる */
  .apply-sec {
    position: relative;
    overflow: hidden;
    padding-block-end: 120px;
    background: linear-gradient(165deg, #ff8f3f 0%, var(--accent) 52%, #f2660d 100%);
  }
  .apply-in {
    position: relative;
    z-index: 1;
  }
  /* SectionHead は子コンポーネントなので :global() で届かせる */
  #apply :global(.section-label) {
    color: #fff;
  }
  #apply :global(.section-label)::before {
    background: #fff;
  }
  #apply :global(.section-head h2) {
    color: #fff;
    text-shadow: 0 2px 24px rgba(146, 64, 0, 0.3);
  }
  #apply :global(.lead) {
    color: rgba(255, 255, 255, 0.94);
    font-weight: 500;
  }

  .apply-box {
    position: relative;
    max-width: 40rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 28px 24px;
  }
  @media (min-width: 860px) {
    .apply-box {
      padding: 40px;
    }
  }
  .fld {
    margin-block-end: 22px;
  }
  .fld label {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-block-end: 8px;
  }
  .req {
    color: var(--accent-2);
    font-size: 12px;
    margin-inline-start: 6px;
  }
  .fld input,
  .fld select,
  .fld textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    line-height: 1.6;
    padding: 12px 14px;
    transition:
      border-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }
  .fld input:focus,
  .fld select:focus,
  .fld textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.28);
  }
  .fineprint {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-block-start: 6px;
  }
  /* 同意チェックボックス: 入力欄の全幅スタイルを打ち消す */
  .consent label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }
  .consent input[type='checkbox'] {
    width: 20px;
    height: 20px;
    flex: none;
    padding: 0;
    margin: 0;
    accent-color: var(--accent);
  }
  .consent input[type='checkbox']:focus {
    box-shadow: none;
  }
  .consent input[type='checkbox']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .submit {
    width: 100%;
  }
  .submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .msg {
    display: none;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 14px;
    margin-block-start: 16px;
  }
  .msg.err {
    display: block;
    background: #fdeeea;
    border: 1px solid #d89a86;
    color: #842f1c;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }
  .done {
    display: none;
    color: #1e7a3c;
    font-size: 14.5px;
    text-align: center;
    padding-block: 10px;
  }
  .honest {
    max-width: 40rem;
    margin-block-start: 24px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    padding: 20px 24px;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--ink-2);
  }
  .honest strong {
    font-weight: 700;
    color: var(--ink);
  }
</style>

<script>
  /**
   * 応募フォーム送信（formsubmit.co 経由で info@mimoria.jp へ）。
   * 初回送信時に formsubmit から有効化メールが届くので、一度だけリンクをクリックして有効化すること。
   * 自動返信（_autoresponse）も有効化後に機能する。
   */
  declare global {
    interface Window {
      gtag?: (...args: unknown[]) => void;
    }
  }

  const SUBMIT_LABEL = 'この内容で応募する（デモ）';
  const form = document.getElementById('applyForm') as HTMLFormElement | null;

  if (form) {
    const msg = document.getElementById('f-status') as HTMLParagraphElement;
    const btn = document.getElementById('f-submit') as HTMLButtonElement;
    const done = document.getElementById('done') as HTMLElement;
    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)
        .value;

    const showError = (text: string) => {
      msg.textContent = text;
      msg.className = 'msg err';
    };
    const showDone = () => {
      form.style.display = 'none';
      done.style.display = 'block';
    };

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      // honeypot: bot が入力していたら送信せず完了表示だけ返す
      if (val('f-honey')) {
        showDone();
        return;
      }
      if (!form.checkValidity()) {
        showError('必須項目と個人情報の取扱いへの同意をご確認ください。');
        form.reportValidity();
        return;
      }
      msg.textContent = '';
      msg.className = 'msg';
      const data = {
        _subject: '[デモ] 応募（demo-recruitフォーム）',
        _template: 'table',
        _replyto: val('f-email').trim(),
        _autoresponse:
          'BURNING BROS. の求人へのご応募ありがとうございます。\nこのメールはデモサイトの自動返信です。応募を受け付けました。\n実際のLPでは、応募内容は当日中に採用担当へ転送され、担当者からご連絡します。\n※このメールは自動送信です。',
        氏名: val('f-name').trim(),
        年代: val('f-age'),
        居住エリア: val('f-area').trim(),
        電話番号: val('f-tel').trim(),
        メールアドレス: val('f-email').trim(),
        経験: val('f-exp').trim(),
        希望稼働: val('f-pref').trim(),
        ひとこと: val('f-msg').trim(),
      };
      btn.disabled = true;
      btn.textContent = '送信中…';
      fetch('https://formsubmit.co/ajax/info@mimoria.jp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      })
        .then((res) => {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(() => {
          if (window.gtag) window.gtag('event', 'generate_lead', { method: 'apply' });
          showDone();
        })
        .catch(() => {
          showError('送信に失敗しました。お手数ですが、しばらくしてから再度お試しください。');
        })
        .finally(() => {
          btn.disabled = false;
          btn.textContent = SUBMIT_LABEL;
        });
    });
  }
</script>
