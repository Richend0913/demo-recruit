---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
---

<section class="section apply-sec" id="apply" style="scroll-margin-top:60px">
  <div class="mesh" aria-hidden="true"></div>
  <div class="container apply-in">
    <SectionHead
      label="応募・お問い合わせ"
      title="まずは話を聞くだけ、でも大歓迎です。"
      lead="右下のAI応募受付で、いつでも質問・応募できます。合否はAIでは決まりません（担当者が面談します）。お電話でもどうぞ。"
    />

    <div class="apply-box">
      <form
        id="applyForm"
        onsubmit="event.preventDefault();gtag('event','generate_lead',{method:'apply'});this.style.display='none';document.getElementById('done').style.display='block';"
      >
        <div class="fld">
          <label for="f-name">お名前 <span class="req">必須</span></label>
          <input id="f-name" required placeholder="山田 太郎" />
        </div>
        <div class="fld">
          <label for="f-contact">ご連絡先（電話 or メール）<span class="req">必須</span></label>
          <input id="f-contact" required placeholder="090-0000-0000" />
        </div>
        <div class="fld">
          <label for="f-msg">ひとこと（わかる範囲でOK）</label>
          <textarea
            id="f-msg"
            rows="3"
            placeholder="未経験ですが興味あります／希望エリアなど"></textarea>
        </div>
        <button class="btn btn--primary btn--arrow submit" type="submit">この内容で応募する（デモ）</button>
      </form>
      <p id="done" class="done">
        応募を受け付けました（デモ）。実際のLPでは担当者に通知が届き、24時間以内にご連絡します。
      </p>
    </div>

    <aside class="honest">
      <p>
        <strong>正直にお伝えします。</strong>
        <Phrases
          text="これは業務委託であり、雇用ではありません（社会保険・雇用保険・有給はありません）。収入は出来高で、金額の保証はありません。車両リース・ガソリン・保険などの経費がかかります。上記はすべて事実です。合わないと感じたら、無理にお勧めしません。"
        />
      </p>
    </aside>
  </div>
</section>

<style>
  /* 応募は署名メッシュのバンドにし、白いフォームカードを浮かべる */
  .apply-sec {
    position: relative;
    overflow: hidden;
    padding-block-end: 120px;
  }
  .apply-in {
    position: relative;
    z-index: 1;
  }
  /* SectionHead は子コンポーネントなので :global() で届かせる */
  #apply :global(.section-label) {
    color: #fff;
  }
  #apply :global(.section-head h2) {
    color: #fff;
    text-shadow: 0 2px 24px rgba(38, 18, 120, 0.25);
  }
  #apply :global(.lead) {
    color: rgba(255, 255, 255, 0.94);
    font-weight: 500;
  }

  .apply-box {
    max-width: 40rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 28px 24px;
  }
  @media (min-width: 860px) {
    .apply-box {
      padding: 40px;
    }
  }
  .fld {
    margin-block-end: 22px;
  }
  .fld label {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-block-end: 8px;
  }
  .req {
    color: var(--accent-2);
    font-size: 12px;
    margin-inline-start: 6px;
  }
  .fld input,
  .fld textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    line-height: 1.6;
    padding: 12px 14px;
    transition:
      border-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }
  .fld input:focus,
  .fld textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(83, 58, 253, 0.22);
  }
  .submit {
    width: 100%;
  }
  .done {
    display: none;
    color: #1e7a3c;
    font-size: 14.5px;
    text-align: center;
    padding-block: 10px;
  }
  .honest {
    max-width: 40rem;
    margin-block-start: 24px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    padding: 20px 24px;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--ink-2);
  }
  .honest strong {
    font-weight: 700;
    color: var(--ink);
  }
</style>
