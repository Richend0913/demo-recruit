---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { appealPoints } from '../data/content';
---

<section class="section" id="appeal">
  <div class="container">
    <SectionHead label="仕事の魅力" title="良いことも、経費も、先に全部見せます。" />
    <dl class="points">
      {
        appealPoints.map((point) => (
          <div class="point">
            <dt>
              <Phrases text={point.title} />
            </dt>
            <dd>
              <Phrases text={point.body} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .points {
    display: grid;
    gap: 0 48px;
  }
  @media (min-width: 860px) {
    .points {
      grid-template-columns: 1fr 1fr;
    }
  }
  .point {
    padding-block: 24px 28px;
    border-block-start: 1px solid var(--line);
  }
  .point dt {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.6;
  }
  .point dt::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    flex: none;
    transform: translateY(-1px);
  }
  .point dd {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.8;
    margin-block-start: 8px;
  }
</style>
