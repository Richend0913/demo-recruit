---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { sceneApplicant as a, sceneListRows, sceneCsvLines } from '../data/content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="section scene-sec" id="scene">
  <div class="container">
    <SectionHead
      label="応募の実物"
      title="応募すると、会社にはこう届きます"
      lead="1人の応募者が、スマホで求人を見て応募し、会社に通知が届いて一覧に載るまで。画面はすべて、このページと同じ仕組みの実物（デモ用のサンプルデータ）です。"
    />

    <div class="scene">
        <!-- 土台: 仕事そのものの写真（朝の積み込み）。応募フローはこの上に浮かぶ -->
        <figure class="sc sc--photo">
          <img
            class="photo-img"
            src={`${base}photo-hero.webp`}
            alt="朝の配送センターで、軽バンの荷室に段ボールを積み込むドライバー"
            width="2048"
            height="1152"
            loading="eager"
            decoding="async"
          />
        </figure>

        <!-- 1. スマホで見る求人 -->
        <figure class="sc sc--phone">
          <figcaption class="sc-cap"><span class="sc-no">01</span>求人を見る（応募者のスマホ）</figcaption>
          <div class="phone">
            <div class="phone-status">
              <span class="phone-time">21:47</span>
              <span class="phone-notch" aria-hidden="true"></span>
              <span class="phone-net">LTE</span>
            </div>
            <div class="phone-body">
              <p class="phone-brand">コスモ軽貨物</p>
              <p class="phone-job">軽貨物ドライバー募集<small>（業務委託）</small></p>
              <ul class="phone-points">
                <li>1配達 <b>150円〜</b>（完全出来高）</li>
                <li>東京都・神奈川県</li>
                <li>未経験可・普通免許（AT可）</li>
              </ul>
              <p class="phone-note"><Phrases text="経費（車両リース月40,000円など）は条件表で全開示" /></p>
              <span class="phone-cta">応募する</span>
              <div class="phone-chat">
                <p class="phone-chat-name">採用受付AI</p>
                <p class="phone-chat-body"><Phrases text="こんにちは。条件や応募のご質問に、いつでもお答えします。" /></p>
              </div>
            </div>
          </div>
        </figure>

        <!-- 2. 応募の送信 -->
        <figure class="sc sc--done">
          <figcaption class="sc-cap"><span class="sc-no">02</span>応募する（送信直後の画面）</figcaption>
          <div class="panel">
            <p class="done-title">応募を受け付けました</p>
            <dl class="kv">
              <div>
                <dt>受付日時</dt>
                <dd>{a.appliedAt}</dd>
              </div>
              <div>
                <dt>お名前</dt>
                <dd>{a.name}</dd>
              </div>
              <div>
                <dt>ご連絡先</dt>
                <dd>{a.contact}</dd>
              </div>
              <div>
                <dt>ひとこと</dt>
                <dd><Phrases text={a.message} /></dd>
              </div>
            </dl>
            <p class="panel-note">
              <Phrases
                text="この内容で受付完了メールが自動送信されます。担当者からは24時間以内にご連絡します（デモ）。"
              />
            </p>
          </div>
        </figure>

        <!-- 3. 会社への通知 -->
        <figure class="sc sc--mail">
          <figcaption class="sc-cap"><span class="sc-no">03</span>会社に届く通知（メール）</figcaption>
          <div class="panel">
            <dl class="kv kv--mail">
              <div>
                <dt>差出人</dt>
                <dd>コスモ軽貨物 採用受付</dd>
              </div>
              <div>
                <dt>件名</dt>
                <dd>{a.name}さん（{a.age}・{a.experience}）</dd>
              </div>
              <div>
                <dt>日時</dt>
                <dd>2026年11月2日 21:47</dd>
              </div>
            </dl>
            <p class="mail-lead"><Phrases text="新しい応募がありました。" /></p>
            <dl class="kv">
              <div>
                <dt>氏名</dt>
                <dd>
                  {a.name}（{a.age}・{a.area}）
                </dd>
              </div>
              <div>
                <dt>連絡先</dt>
                <dd>{a.contact}</dd>
              </div>
              <div>
                <dt>希望稼働</dt>
                <dd>{a.desired}・{a.experience}</dd>
              </div>
              <div>
                <dt>ひとこと</dt>
                <dd><Phrases text={a.message} /></dd>
              </div>
            </dl>
            <p class="panel-note">
              <Phrases text="夜間・休日の応募もその場で受け付け、応募者への自動返信まで済ませます。" />
            </p>
          </div>
        </figure>

        <!-- 4. 応募者一覧・CSV -->
        <figure class="sc sc--wide">
          <figcaption class="sc-cap"><span class="sc-no">04</span>応募者一覧とCSV（会社側）</figcaption>
          <div class="panel">
            <div class="list-head">
              <p class="list-title">応募者一覧<span class="list-month">2026年11月</span></p>
              <span class="csv-btn">CSVでダウンロード</span>
            </div>
            <div class="list-scroll">
              <table class="list-tbl">
                <thead>
                  <tr>
                    <th scope="col">応募日時</th>
                    <th scope="col">氏名</th>
                    <th scope="col">属性</th>
                    <th scope="col">希望・経験</th>
                    <th scope="col">対応状況</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    sceneListRows.map((row) => (
                      <tr class={row.isNew ? 'is-new' : undefined}>
                        <td class="td-time">{row.datetime}</td>
                        <td class="td-name">{row.name}</td>
                        <td>{row.profile}</td>
                        <td>{row.wish}</td>
                        <td class={row.isNew ? 'td-status is-new-status' : 'td-status'}>
                          {row.status}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <div class="csv">
              <p class="csv-name">applicants_2026-11.csv</p>
              <pre class="csv-body">{sceneCsvLines.join('\n')}</pre>
            </div>
            <p class="panel-note">
              <Phrases
                text="応募は一覧で管理でき、そのままCSVで書き出せます。媒体ごとに分かれていた応募も、ここに一本化されます。"
              />
            </p>
          </div>
        </figure>
    </div>

    <p class="scene-note">
      ※ 画面はいずれもデモ用のサンプルです。氏名はイニシャル、連絡先は伏字で表示しています。
    </p>
  </div>
</section>

<style>
  /* ヒーローのメッシュにパネル群を重ねる */
  .scene-sec {
    position: relative;
    z-index: 2;
    margin-block-start: -84px;
    padding-block-start: 0;
    overflow: visible;
  }
  @media (min-width: 860px) {
    .scene-sec {
      margin-block-start: -104px;
    }
  }

  /* ---------- 構図 ---------- */
  .scene {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 44px 24px;
  }

  /* ---------- 写真（シーンの土台） ----------
     仕事そのものの写真を大きな面で置き、応募フローのパネルが
     その縁に浮かぶ構図にする。写真が視覚の主役。 */
  .sc.sc--photo {
    display: block;
    z-index: 0;
    aspect-ratio: 4 / 3;
  }
  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* ドライバー（右寄り・顔は上部）を切り抜きで殺さない */
    object-position: 58% 32%;
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 700px) and (max-width: 1023.98px) {
    .scene {
      grid-template-columns: 320px 1fr;
      align-items: start;
    }
    .sc.sc--photo {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 8;
    }
    .sc--phone {
      grid-row: 2 / 4;
    }
    .sc--mail {
      grid-column: 2;
    }
    .sc--wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .scene {
      grid-template-columns: repeat(12, 1fr);
      gap: 0 24px;
    }
    .sc.sc--photo {
      grid-column: 1 / 10;
      grid-row: 1;
      aspect-ratio: 16 / 10;
    }
    .sc--phone {
      grid-column: 1 / 5;
      grid-row: 1 / 3;
      /* 写真の左下に重ねて沈める */
      margin-block-start: 168px;
      z-index: 3;
    }
    .sc--done {
      grid-column: 6 / 11;
      grid-row: 1;
      margin-block-start: 56px;
      align-self: start;
      z-index: 3;
    }
    .sc--done .panel {
      /* 通知パネルが重なる分、完了パネルの下部に余白を確保して本文を守る */
      padding-block-end: 76px;
    }
    .sc--mail {
      grid-column: 8 / 13;
      grid-row: 2;
      /* 写真の右下の縁にも食い込ませる */
      margin-block-start: -48px;
      z-index: 4;
      align-self: start;
    }
    .sc--mail .panel {
      transform: rotate(0.6deg);
    }
    .sc--wide {
      grid-column: 2 / 13;
      grid-row: 3;
      margin-block-start: 56px;
    }
  }

  .sc {
    min-width: 0;
    position: relative;
    /* 縦フレックス: パネルは figure の残り高さに合わせる
       （height:100% はモバイルでキャプション分はみ出し、後続の注記を隠すため使わない） */
    display: flex;
    flex-direction: column;
    animation: scene-rise 0.55s var(--ease-out) both;
  }
  .sc--done {
    animation-delay: 0.08s;
  }
  .sc--mail {
    animation-delay: 0.16s;
  }
  .sc--wide {
    animation-delay: 0.24s;
  }
  @keyframes scene-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .sc-cap {
    position: relative;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    padding: 7px 16px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-inline-start: 18px;
    margin-block-end: -14px;
  }
  .sc-no {
    font-family: var(--font-num);
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  /* ---------- スマホ ---------- */
  .phone {
    max-width: 320px;
    margin-inline: auto;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 36px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transform: rotate(-1.5deg);
  }
  @media (min-width: 1024px) {
    .phone {
      margin-inline: 0;
      transform: rotate(-2.5deg);
    }
  }
  .phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 22px 4px;
    font-size: 12px;
    font-weight: 700;
  }
  .phone-time {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
  }
  .phone-notch {
    width: 72px;
    height: 18px;
    border-radius: 9px;
    background: var(--ink);
  }
  .phone-net {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }
  .phone-body {
    padding: 16px 20px 24px;
  }
  .phone-brand {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    padding-block-end: 10px;
    border-block-end: 1px solid var(--line);
  }
  .phone-job {
    font-size: 19px;
    font-weight: 800;
    line-height: 1.5;
    margin-block-start: 14px;
  }
  .phone-job small {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .phone-points {
    list-style: none;
    margin-block-start: 12px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .phone-points li {
    padding-block: 7px;
    border-block-end: 1px solid var(--line-soft);
  }
  .phone-points b {
    color: var(--accent);
    font-size: 15px;
  }
  .phone-note {
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--ink-3);
    margin-block-start: 12px;
  }
  .phone-cta {
    display: grid;
    place-items: center;
    min-height: 46px;
    margin-block-start: 14px;
    background: var(--accent);
    color: #fff;
    border-radius: 12px;
    font-weight: 800;
    font-size: 14.5px;
    letter-spacing: 0.05em;
    box-shadow: 0 10px 22px rgba(83, 58, 253, 0.35);
  }
  .phone-chat {
    margin-block-start: 16px;
    padding: 12px 14px;
    background: #f0efff;
    border-radius: 12px;
  }
  .phone-chat-name {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .phone-chat-body {
    font-size: 12.5px;
    line-height: 1.7;
    color: #3730a3;
    margin-block-start: 4px;
  }

  /* ---------- パネル共通 ---------- */
  .panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    padding: 26px 24px;
    flex: 1 1 auto;
  }
  @media (min-width: 860px) {
    .panel {
      padding: 28px 28px;
    }
  }
  .done-title {
    font-size: var(--fs-h3);
    font-weight: 800;
    padding-block-end: 14px;
    border-block-end: 1px solid var(--line);
  }
  .kv {
    font-size: var(--fs-sm);
  }
  .kv > div {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 12px;
    padding-block: 9px;
    border-block-end: 1px solid var(--line-soft);
  }
  .kv dt {
    font-weight: 700;
    color: var(--ink-3);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    padding-block-start: 2px;
    white-space: nowrap;
  }
  .kv dd {
    color: var(--ink-2);
    line-height: 1.7;
  }
  .kv--mail {
    padding-block-end: 4px;
    border-block-end: 1px solid var(--line);
  }
  .kv--mail dd {
    color: var(--ink);
    font-weight: 500;
  }
  .mail-lead {
    font-size: var(--fs-sm);
    font-weight: 700;
    margin-block-start: 14px;
  }
  .panel-note {
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--ink-3);
    margin-block-start: 16px;
  }

  /* ---------- 一覧・CSV ---------- */
  .list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding-block-end: 14px;
    border-block-end: 1px solid var(--line);
  }
  .list-title {
    font-weight: 800;
    font-size: 15px;
    white-space: nowrap;
  }
  .list-month {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-3);
    margin-inline-start: 10px;
    white-space: nowrap;
  }
  .csv-btn {
    flex: none;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 16px;
    color: var(--accent);
    background: var(--accent-tint);
  }
  .list-scroll {
    overflow-x: auto;
  }
  .list-tbl {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .list-tbl th,
  .list-tbl td {
    text-align: left;
    padding: 11px 10px 11px 2px;
    border-block-end: 1px solid var(--line-soft);
    white-space: nowrap;
  }
  .list-tbl thead th {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .list-tbl tbody tr.is-new td {
    background: var(--accent-tint);
  }
  .list-tbl tbody tr.is-new td:first-child {
    box-shadow: inset 3px 0 0 var(--accent-2);
  }
  .td-time {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    color: var(--ink-2);
  }
  .td-name {
    font-weight: 800;
  }
  .td-status {
    color: var(--ink-2);
  }
  .is-new-status {
    color: var(--accent-2);
    font-weight: 700;
  }
  .csv {
    margin-block-start: 20px;
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .csv-name {
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.03em;
    background: var(--ink);
    color: #fff;
    padding: 9px 16px;
  }
  .csv-body {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.8;
    color: var(--ink-2);
    padding: 12px 16px;
    overflow-x: auto;
    white-space: pre;
  }

  .scene-note {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-block-start: 36px;
  }
</style>
