---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { sceneApplicant as a, sceneListRows, sceneCsvLines } from '../data/content';
---

<section class="section scene-sec" id="scene">
  <div class="container">
    <SectionHead
      label="応募の実物"
      title="応募すると、会社にはこう届きます"
      lead="1人の応募者が、スマホで求人を見て応募し、会社に通知が届いて一覧に載るまで。画面はすべて、このページと同じ仕組みの実物（デモ用のサンプルデータ）です。"
    />

    <div class="scene-stage">
      <div class="scene-field" aria-hidden="true"></div>
      <div class="scene">
        <!-- 1. スマホで見る求人 -->
        <figure class="sc sc--phone">
          <figcaption class="sc-cap"><span class="sc-no">01</span>求人を見る（応募者のスマホ）</figcaption>
          <div class="phone">
            <div class="phone-status">
              <span class="phone-time">21:47</span>
              <span class="phone-notch" aria-hidden="true"></span>
              <span class="phone-net">LTE</span>
            </div>
            <div class="phone-body">
              <p class="phone-brand">コスモ軽貨物</p>
              <p class="phone-job">軽貨物ドライバー募集<small>（業務委託）</small></p>
              <ul class="phone-points">
                <li>1配達 <b>150円〜</b>（完全出来高）</li>
                <li>東京都・神奈川県</li>
                <li>未経験可・普通免許（AT可）</li>
              </ul>
              <p class="phone-note"><Phrases text="経費（車両リース月40,000円など）は条件表で全開示" /></p>
              <span class="phone-cta">応募する</span>
              <div class="phone-chat">
                <p class="phone-chat-name">採用受付AI</p>
                <p class="phone-chat-body"><Phrases text="こんにちは。条件や応募のご質問に、いつでもお答えします。" /></p>
              </div>
            </div>
          </div>
        </figure>

        <!-- 2. 応募の送信 -->
        <figure class="sc sc--done">
          <figcaption class="sc-cap"><span class="sc-no">02</span>応募する（送信直後の画面）</figcaption>
          <div class="panel">
            <p class="done-title">応募を受け付けました</p>
            <dl class="kv">
              <div>
                <dt>受付日時</dt>
                <dd>{a.appliedAt}</dd>
              </div>
              <div>
                <dt>お名前</dt>
                <dd>{a.name}</dd>
              </div>
              <div>
                <dt>ご連絡先</dt>
                <dd>{a.contact}</dd>
              </div>
              <div>
                <dt>ひとこと</dt>
                <dd><Phrases text={a.message} /></dd>
              </div>
            </dl>
            <p class="panel-note">
              <Phrases
                text="この内容で受付完了メールが自動送信されます。担当者からは24時間以内にご連絡します（デモ）。"
              />
            </p>
          </div>
        </figure>

        <!-- 3. 会社への通知 -->
        <figure class="sc sc--mail">
          <figcaption class="sc-cap"><span class="sc-no">03</span>会社に届く通知（メール）</figcaption>
          <div class="panel">
            <dl class="kv kv--mail">
              <div>
                <dt>差出人</dt>
                <dd>コスモ軽貨物 採用受付</dd>
              </div>
              <div>
                <dt>件名</dt>
                <dd>{a.name}さん（{a.age}・{a.experience}）</dd>
              </div>
              <div>
                <dt>日時</dt>
                <dd>2026年11月2日 21:47</dd>
              </div>
            </dl>
            <p class="mail-lead"><Phrases text="新しい応募がありました。" /></p>
            <dl class="kv">
              <div>
                <dt>氏名</dt>
                <dd>
                  {a.name}（{a.age}・{a.area}）
                </dd>
              </div>
              <div>
                <dt>連絡先</dt>
                <dd>{a.contact}</dd>
              </div>
              <div>
                <dt>希望稼働</dt>
                <dd>{a.desired}・{a.experience}</dd>
              </div>
              <div>
                <dt>ひとこと</dt>
                <dd><Phrases text={a.message} /></dd>
              </div>
            </dl>
            <p class="panel-note">
              <Phrases text="夜間・休日の応募もその場で受け付け、応募者への自動返信まで済ませます。" />
            </p>
          </div>
        </figure>

        <!-- 4. 応募者一覧・CSV -->
        <figure class="sc sc--wide">
          <figcaption class="sc-cap"><span class="sc-no">04</span>応募者一覧とCSV（会社側）</figcaption>
          <div class="panel">
            <div class="list-head">
              <p class="list-title">応募者一覧<span class="list-month">2026年11月</span></p>
              <span class="csv-btn">CSVでダウンロード</span>
            </div>
            <div class="list-scroll">
              <table class="list-tbl">
                <thead>
                  <tr>
                    <th scope="col">応募日時</th>
                    <th scope="col">氏名</th>
                    <th scope="col">属性</th>
                    <th scope="col">希望・経験</th>
                    <th scope="col">対応状況</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    sceneListRows.map((row) => (
                      <tr class={row.isNew ? 'is-new' : undefined}>
                        <td class="td-time">{row.datetime}</td>
                        <td class="td-name">{row.name}</td>
                        <td>{row.profile}</td>
                        <td>{row.wish}</td>
                        <td class={row.isNew ? 'td-status is-new-status' : 'td-status'}>
                          {row.status}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <div class="csv">
              <p class="csv-name">applicants_2026-11.csv</p>
              <pre class="csv-body">{sceneCsvLines.join('\n')}</pre>
            </div>
            <p class="panel-note">
              <Phrases
                text="応募は一覧で管理でき、そのままCSVで書き出せます。媒体ごとに分かれていた応募も、ここに一本化されます。"
              />
            </p>
          </div>
        </figure>
      </div>
    </div>

    <p class="scene-note">
      ※ 画面はいずれもデモ用のサンプルです。氏名はイニシャル、連絡先は伏字で表示しています。
    </p>
  </div>
</section>

<style>
  .scene-sec {
    overflow: hidden;
  }
  .scene-sec + .section {
    border-block-start: 0;
  }

  /* ---------- フィールド（斜めのトーンウォッシュ） ---------- */
  .scene-stage {
    position: relative;
    margin-block-start: 8px;
  }
  .scene-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .scene-field::before {
    content: '';
    position: absolute;
    inset: 1% -6%;
    background: linear-gradient(180deg, var(--amber-050), rgba(253, 248, 239, 0) 88%);
    border-radius: 24px;
  }
  @media (min-width: 1024px) {
    /* フィールドはビューポート幅いっぱいに流す（カード状に閉じない） */
    .scene-field::before {
      inset: auto auto auto 50%;
      top: 7%;
      width: 100vw;
      height: 64%;
      background: linear-gradient(
        100deg,
        var(--amber-100) 0%,
        var(--amber-200) 55%,
        var(--amber-100) 100%
      );
      transform: translateX(-50%) skewY(-4deg);
      border-radius: 0;
    }
    .scene-field::after {
      content: '';
      position: absolute;
      inset: auto auto auto 50%;
      top: 13%;
      width: 100vw;
      height: 58%;
      background: linear-gradient(105deg, rgba(224, 138, 43, 0.18), rgba(224, 138, 43, 0) 62%);
      transform: translateX(-50%) skewY(-7deg);
      border-radius: 0;
    }
  }

  /* ---------- 構図 ---------- */
  .scene {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 44px 24px;
  }
  @media (min-width: 700px) and (max-width: 1023.98px) {
    .scene {
      grid-template-columns: 320px 1fr;
      align-items: start;
    }
    .sc--wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .scene {
      grid-template-columns: repeat(12, 1fr);
      gap: 0 24px;
    }
    .sc--phone {
      grid-column: 1 / 5;
      grid-row: 1 / 3;
    }
    .sc--done {
      grid-column: 5 / 10;
      grid-row: 1;
      margin-block-start: 64px;
      align-self: start;
    }
    .sc--done .panel {
      /* 通知パネルが重なる分、完了パネルの下部に余白を確保して本文を守る */
      padding-block-end: 76px;
    }
    .sc--mail {
      grid-column: 7 / 13;
      grid-row: 2;
      margin-block-start: -36px;
      z-index: 3;
      align-self: start;
    }
    .sc--wide {
      grid-column: 2 / 13;
      grid-row: 3;
      margin-block-start: 56px;
    }
  }

  .sc {
    min-width: 0;
    position: relative;
    /* 縦フレックス: パネルは figure の残り高さに合わせる
       （height:100% はモバイルでキャプション分はみ出し、後続の注記を隠すため使わない） */
    display: flex;
    flex-direction: column;
  }
  .sc-cap {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-block-end: 14px;
  }
  .sc-cap::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    flex: none;
  }
  .sc-no {
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--accent-dark);
  }
  @media (min-width: 1024px) {
    /* 構図の中ではキャプションをパネル上端にまたがるタグとして置く */
    .sc-cap {
      position: relative;
      z-index: 5;
      display: inline-flex;
      background: var(--paper);
      border: 1px solid rgba(38, 32, 25, 0.16);
      border-radius: 3px;
      padding: 7px 14px;
      margin-inline-start: 20px;
      margin-block-end: -15px;
    }
  }

  /* ---------- スマホ ---------- */
  .phone {
    max-width: 320px;
    margin-inline: auto;
    background: var(--paper);
    border: 2px solid var(--ink-deep);
    border-radius: 36px;
    overflow: hidden;
    /* 奥行きはオフセットした色面レイヤーで作る（ぼかし影ではない） */
    box-shadow: 16px 18px 0 0 var(--amber-200);
  }
  @media (min-width: 1024px) {
    .phone {
      margin-inline: 0;
      transform: rotate(-2deg);
    }
  }
  .phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 22px 4px;
    font-size: 12px;
    font-weight: 700;
  }
  .phone-time {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
  }
  .phone-notch {
    width: 72px;
    height: 18px;
    border-radius: 9px;
    background: var(--ink-deep);
  }
  .phone-net {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }
  .phone-body {
    padding: 16px 20px 24px;
  }
  .phone-brand {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    padding-block-end: 10px;
    border-block-end: 1px solid var(--line);
  }
  .phone-job {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
    margin-block-start: 14px;
  }
  .phone-job small {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .phone-points {
    list-style: none;
    margin-block-start: 12px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .phone-points li {
    padding-block: 7px;
    border-block-end: 1px solid var(--line-soft);
  }
  .phone-points b {
    color: var(--ink);
    font-size: 15px;
  }
  .phone-note {
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--ink-3);
    margin-block-start: 12px;
  }
  .phone-cta {
    display: grid;
    place-items: center;
    min-height: 46px;
    margin-block-start: 14px;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: 0.05em;
  }
  .phone-chat {
    margin-block-start: 16px;
    padding: 12px 14px;
    background: var(--paper-warm);
    border-radius: var(--radius);
  }
  .phone-chat-name {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-dark);
  }
  .phone-chat-body {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-2);
    margin-block-start: 4px;
  }

  /* ---------- パネル共通 ---------- */
  .panel {
    background: var(--paper);
    border: 1px solid rgba(38, 32, 25, 0.16);
    border-radius: 6px;
    padding: 24px;
    flex: 1 1 auto;
    /* オフセットした色面レイヤー（ぼかしのない階調） */
    box-shadow: 14px 14px 0 0 var(--amber-200);
  }
  .sc--wide .panel {
    box-shadow: 14px 14px 0 0 var(--paper-warm-2);
  }
  .done-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    padding-block-end: 14px;
    border-block-end: 1px solid var(--line);
  }
  .kv {
    font-size: var(--fs-sm);
  }
  .kv > div {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 12px;
    padding-block: 9px;
    border-block-end: 1px solid var(--line-soft);
  }
  .kv dt {
    font-weight: 700;
    color: var(--ink-3);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    padding-block-start: 2px;
    white-space: nowrap;
  }
  .kv dd {
    color: var(--ink-2);
    line-height: 1.7;
  }
  .kv--mail {
    padding-block-end: 4px;
    border-block-end: 1px solid var(--line);
  }
  .kv--mail dd {
    color: var(--ink);
    font-weight: 500;
  }
  .mail-lead {
    font-size: var(--fs-sm);
    margin-block-start: 14px;
  }
  .panel-note {
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--ink-3);
    margin-block-start: 16px;
  }

  /* ---------- 一覧・CSV ---------- */
  .list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding-block-end: 14px;
    border-block-end: 1px solid var(--line);
  }
  .list-title {
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
  }
  .list-month {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-3);
    margin-inline-start: 10px;
    white-space: nowrap;
  }
  .csv-btn {
    flex: none;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    padding: 6px 14px;
  }
  .list-scroll {
    overflow-x: auto;
  }
  .list-tbl {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .list-tbl th,
  .list-tbl td {
    text-align: left;
    padding: 11px 10px 11px 2px;
    border-block-end: 1px solid var(--line-soft);
    white-space: nowrap;
  }
  .list-tbl thead th {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .list-tbl tbody tr.is-new td {
    background: var(--amber-050);
  }
  .list-tbl tbody tr.is-new td:first-child {
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .td-time {
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    color: var(--ink-2);
  }
  .td-name {
    font-weight: 700;
  }
  .td-status {
    color: var(--ink-2);
  }
  .is-new-status {
    color: var(--accent-dark);
    font-weight: 700;
  }
  .csv {
    margin-block-start: 20px;
    background: #f8f4ec;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .csv-name {
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.03em;
    background: var(--ink-deep);
    color: #f5f1e8;
    padding: 9px 16px;
  }
  .csv-body {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.8;
    color: var(--ink-2);
    padding: 12px 16px;
    overflow-x: auto;
    white-space: pre;
  }

  .scene-note {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-block-start: 36px;
  }
</style>
