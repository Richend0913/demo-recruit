---
/**
 * 日本語の文節境界でのみ改行させるためのコンポーネント。
 * BudouX で文を文節に分割し、各文節を inline-block 化することで、
 * 文節の途中では折り返さない（文節の境界だけが改行位置になる）。
 * 長い文では「／」でも先に分割し、1チャンクが行幅を超えて
 * 内部で割れる（例: ガソ|リン）ことを防ぐ。
 */
import { loadDefaultJapaneseParser } from 'budoux';

interface Props {
  text: string;
}

const parser = loadDefaultJapaneseParser();
const { text } = Astro.props;
const phrases = text
  .split(/(?<=／)/)
  .flatMap((part) => (part ? parser.parse(part) : []));
---

{
  phrases.map((p) => <span class="ph">{p}</span>)
}

<style>
  .ph {
    display: inline-block;
    max-width: 100%;
  }
</style>
