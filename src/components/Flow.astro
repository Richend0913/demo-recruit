---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { flowSteps } from '../data/content';
---

<section class="section" id="flow">
  <div class="container">
    <SectionHead label="応募の流れ" title="応募から稼働開始まで" />
    <ol class="steps">
      {
        flowSteps.map((step, i) => (
          <li class="step">
            <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3>
                <Phrases text={step.title} />
              </h3>
              <p><Phrases text={step.body} /></p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    max-width: 46rem;
    display: grid;
    gap: 16px;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    padding: 22px 24px;
  }
  .step-no {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 18px rgba(83, 58, 253, 0.32);
  }
  .step h3 {
    font-size: var(--fs-h3);
    padding-block-start: 8px;
  }
  .step p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.8;
    margin-block-start: 4px;
  }
</style>
