---
import Phrases from './Phrases.astro';
---

<section class="hero" id="top">
  <div class="mesh" aria-hidden="true"></div>
  <div class="container hero-in">
    <p class="hero-eyebrow">業務委託ドライバー募集（軽貨物）</p>
    <h1 class="hero-title">
      <Phrases text="手取りの現実を、正直にお見せします。" />
    </h1>
    <p class="hero-sub">
      <Phrases
        text="「月◯万可能！」ではなく、経費を引いた後の手取りをシミュレータで。あなたの稼働に合わせて、いくら残るかを先に確かめてください。未経験・普通免許でOK、同乗研修あり。"
      />
    </p>

    <div class="hero-btns">
      <a
        class="btn btn--white btn--arrow"
        href="#apply"
        onclick="gtag('event','generate_lead',{method:'apply'})">応募する</a
      >
      <a class="tlink tlink--light" href="#terms">条件を確認する</a>
      <a class="tlink tlink--light" href="#sim">シミュレータで手取りを見る</a>
    </div>

    <dl class="hero-specs">
      <div class="spec">
        <dt>職種</dt>
        <dd>軽貨物ドライバー<small>（業務委託）</small></dd>
      </div>
      <div class="spec">
        <dt>報酬</dt>
        <dd>1配達 150円〜<small>（完全出来高・手取り目安は試算で）</small></dd>
      </div>
      <div class="spec">
        <dt>勤務地</dt>
        <dd>東京都・神奈川県<small>（架空）</small></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* 署名メッシュの上に白のディスプレイを置く。
     下端はシーンのパネルが重なるため、余白を深めに取る */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 56px 132px;
  }
  @media (min-width: 860px) {
    .hero {
      padding-block: 84px 168px;
    }
  }
  .hero-in {
    position: relative;
    z-index: 1;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 6px 14px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    margin-block-end: 30px;
  }
  .hero-title {
    color: #fff;
    font-weight: 900;
    font-size: var(--fs-display);
    line-height: 1.22;
    letter-spacing: -0.02em;
    max-width: 13em;
    text-shadow: 0 2px 28px rgba(38, 18, 120, 0.28);
  }
  @media (min-width: 860px) {
    .hero-title {
      line-height: 1.18;
    }
  }
  .hero-sub {
    margin-block-start: 26px;
    color: rgba(255, 255, 255, 0.94);
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.85;
    max-width: 38em;
  }

  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 30px;
    margin-block-start: 38px;
  }

  /* スペックはメッシュ上のガラスストリップとして置く */
  .hero-specs {
    margin-block-start: 52px;
    display: grid;
    gap: 18px;
    background: rgba(52, 24, 160, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 16px;
    padding: 20px 22px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    max-width: 880px;
  }
  @media (min-width: 860px) {
    .hero-specs {
      grid-template-columns: repeat(3, 1fr);
      gap: 0 32px;
      padding: 22px 28px;
    }
  }
  .spec {
    display: grid;
    grid-template-columns: 4.2em 1fr;
    gap: 12px;
    align-items: baseline;
    align-content: start;
  }
  @media (min-width: 860px) {
    .spec {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .spec dt {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
  }
  .spec dd {
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.5;
  }
  @media (min-width: 860px) {
    .spec dd {
      font-size: 19px;
    }
  }
  .spec dd small {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
    margin-block-start: 2px;
  }
  @media (min-width: 860px) {
    .spec dd small {
      display: inline-block;
      margin-block-start: 0;
      margin-inline-start: 6px;
    }
  }
</style>
