---
import Phrases from './Phrases.astro';
---

<section class="hero" id="top">
  <div class="container">
    <p class="hero-eyebrow">業務委託ドライバー募集（軽貨物）</p>
    <h1 class="hero-title">
      <Phrases text="手取りの現実を、正直にお見せします。" />
    </h1>
    <p class="hero-sub">
      <Phrases
        text="「月◯万可能！」ではなく、経費を引いた後の手取りをシミュレータで。あなたの稼働に合わせて、いくら残るかを先に確かめてください。未経験・普通免許でOK、同乗研修あり。"
      />
    </p>

    <dl class="hero-specs">
      <div class="spec">
        <dt>職種</dt>
        <dd>軽貨物ドライバー<small>（業務委託）</small></dd>
      </div>
      <div class="spec">
        <dt>報酬</dt>
        <dd>1配達 150円〜<small>（完全出来高・手取り目安は試算で）</small></dd>
      </div>
      <div class="spec">
        <dt>勤務地</dt>
        <dd>東京都・神奈川県<small>（架空）</small></dd>
      </div>
    </dl>

    <div class="hero-btns">
      <a class="btn btn--primary" href="#apply">応募する</a>
      <a class="btn btn--ghost" href="#terms">条件を確認する</a>
      <a class="btn btn--ghost" href="#sim">シミュレータで手取りを見る</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 72px 80px;
  }
  @media (min-width: 860px) {
    .hero {
      padding-block: 96px 104px;
    }
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--accent-dark);
    margin-block-end: 24px;
  }
  .hero-title {
    font-size: var(--fs-display);
    line-height: 1.45;
    max-width: 16em;
  }
  .hero-sub {
    margin-block-start: 28px;
    color: var(--ink-2);
    font-size: var(--fs-lead);
    line-height: 1.85;
    max-width: 38em;
  }

  .hero-specs {
    margin-block-start: 48px;
    border-block-start: 1px solid var(--ink);
  }
  .spec {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 16px;
    align-items: baseline;
    padding-block: 14px;
    border-block-end: 1px solid var(--line-soft);
  }
  .spec dt {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  .spec dd {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  @media (min-width: 860px) {
    .spec dd {
      font-size: 21px;
    }
  }
  .spec dd small {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-2);
    margin-inline-start: 6px;
  }
  @media (min-width: 860px) {
    .hero-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0 40px;
    }
    .spec {
      grid-template-columns: 1fr;
      gap: 4px;
      padding-block: 16px 20px;
    }
  }

  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 40px;
  }
</style>
