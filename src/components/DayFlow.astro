---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { daySteps } from '../data/content';
---

<section class="section" id="day">
  <div class="container">
    <SectionHead label="1日の流れ" title="だいたいこんな感じです" />
    <ol class="steps">
      {
        daySteps.map((step) => (
          <li class="step">
            <div class="step-body">
              <h3>
                <span class="step-time">{step.time}</span>
                <Phrases text={step.title} />
              </h3>
              <p><Phrases text={step.body} /></p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    max-width: 46rem;
  }
  .step {
    padding-block: 20px;
    border-block-end: 1px solid var(--line-soft);
  }
  .step:first-child {
    border-block-start: 1px solid var(--line);
  }
  .step h3 {
    font-size: var(--fs-h3);
    line-height: 1.6;
  }
  .step-time {
    display: inline-block;
    min-width: 6.5em;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    margin-inline-end: 12px;
    white-space: nowrap;
  }
  .step p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.8;
    margin-block-start: 4px;
  }
</style>
