---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { daySteps } from '../data/content';

const base = import.meta.env.BASE_URL;
---

<section class="section section--warm" id="day">
  <div class="container">
    <SectionHead label="1日の流れ" title="だいたいこんな感じです" />
    <div class="day-layout">
      <ol class="steps">
        {
          daySteps.map((step) => (
            <li class="step">
              <div class="step-body">
                <h3>
                  <span class="step-time">{step.time}</span>
                  <Phrases text={step.title} />
                </h3>
                <p><Phrases text={step.body} /></p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="day-photos">
        <figure class="day-photo">
          <img
            src={`${base}photo-warehouse.webp`}
            alt="配送センターのコンベアで荷物を仕分けるスタッフと、ドックに停まる軽バン"
            width="1920"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="day-photo">
          <img
            src={`${base}photo-street.webp`}
            alt="夕方の住宅街で、玄関先へ段ボール箱を届けるドライバー"
            width="1920"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* 左に流れ、右に1日の写真（朝の仕分け→夕方の配達） */
  .day-layout {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 1024px) {
    .day-layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 36px;
      align-items: start;
    }
  }
  .day-photos {
    display: grid;
    gap: 24px;
    max-width: 46rem;
  }
  @media (min-width: 1024px) {
    .day-photos {
      max-width: none;
    }
  }
  .day-photo {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 1024px) {
    .day-photo {
      aspect-ratio: 16 / 10;
    }
  }
  .day-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .steps {
    list-style: none;
    max-width: 46rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    padding: 8px 26px;
  }
  @media (min-width: 1024px) {
    .steps {
      max-width: none;
    }
  }
  .step {
    padding-block: 20px;
    border-block-end: 1px solid var(--line-soft);
  }
  .step:last-child {
    border-block-end: 0;
  }
  .step h3 {
    font-size: var(--fs-h3);
    line-height: 1.6;
  }
  .step-time {
    display: inline-block;
    min-width: 6.5em;
    font-family: var(--font-num);
    font-feature-settings: 'tnum' 1;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
    margin-inline-end: 12px;
    white-space: nowrap;
  }
  .step p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.8;
    margin-block-start: 4px;
  }
</style>
