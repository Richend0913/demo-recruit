---
import Phrases from './Phrases.astro';

interface Props {
  label: string;
  title: string;
  lead?: string;
}

const { label, title, lead } = Astro.props;
---

<div class="section-head">
  <p class="section-label">{label}</p>
  <h2><Phrases text={title} /></h2>
  {lead && <p class="lead"><Phrases text={lead} /></p>}
</div>
