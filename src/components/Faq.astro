---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { faqItems } from '../data/content';
---

<section class="section section--alt" id="faq">
  <div class="container">
    <SectionHead no="06" label="よくある質問" title="気になること" />
    <div class="faq-list">
      {
        faqItems.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p><Phrases text={item.a} /></p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 46rem;
    border-block-start: 1px solid var(--line);
  }
  details {
    border-block-end: 1px solid var(--line-soft);
    padding-block: 20px;
  }
  summary {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.02em;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '＋';
    font-weight: 400;
    color: var(--ink-3);
    font-size: 15px;
    flex: none;
  }
  details[open ] summary::after {
    content: '−';
  }
  details p {
    color: var(--ink-2);
    font-size: 15px;
    margin-block-start: 10px;
    max-width: var(--w-text);
  }
</style>
