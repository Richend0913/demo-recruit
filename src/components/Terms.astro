---
import SectionHead from './SectionHead.astro';
import Phrases from './Phrases.astro';
import { terms } from '../data/content';
---

<section class="section section--alt" id="terms">
  <div class="container">
    <SectionHead
      label="条件開示"
      title="募集条件"
      lead="良い条件だけを抜き出さず、負担も含めて全項目を載せます。金額は手取りシミュレータの計算条件と一致しています。"
    />
    <table class="tbl">
      <tbody>
        {
          terms.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>
                {row.strong && <strong>{row.strong}</strong>}
                <Phrases text={row.body} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="tbl-note">※ 本ページの条件・金額はすべてデモ用のサンプルです。実際の募集では、契約時に書面（電磁的方法）で明示されます。</p>
  </div>
</section>

<style>
  /* 条件はライトバンド上の白カード（スペックシート）として置く */
  .tbl {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 15px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .tbl th,
  .tbl td {
    padding: 18px 22px;
    text-align: left;
    vertical-align: top;
    border-block-end: 1px solid var(--line);
    line-height: 1.7;
  }
  .tbl tr:last-child th,
  .tbl tr:last-child td {
    border-block-end: 0;
  }
  .tbl th {
    width: 26%;
    font-weight: 700;
    font-size: 13.5px;
    color: var(--ink-2);
    letter-spacing: 0.03em;
    background: #fdfaf6;
    border-inline-end: 1px solid var(--line);
    white-space: nowrap;
  }
  .tbl td {
    color: var(--ink-2);
  }
  .tbl td strong {
    color: var(--ink);
  }
  .tbl-note {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-block-start: 16px;
  }
  @media (max-width: 560px) {
    /* モバイルはラベルと本文を積む（スペック表のモバイル形式）。
       本文が全幅になるので、文節チャンクが行幅を超えて内部で割れない。 */
    .tbl th,
    .tbl td {
      display: block;
      width: auto;
    }
    .tbl th {
      font-size: 13px;
      padding-block: 14px 22px 0;
      background: var(--paper);
      border-inline-end: 0;
      border-block-end: 0;
    }
    .tbl td {
      font-size: 14px;
      padding-block: 2px 22px 16px;
    }
  }
</style>
